<!DOCTYPE html>
<html>
<head><title><%= content.title %></title><meta name="viewport" content="width=device-width, initial-scale=1">
<style>body{margin:0;background:#000;color:#fff;font-family:sans-serif} .video{width:100%;height:80vh;background:#000} iframe,video{width:100%;height:100%;border:none} .info{padding:20px} a{color:#e50914}</style>
</head>
<body>
<div class="video">
<% if(content.url.includes('youtube') || content.url.includes('embed')){ %>
<iframe src="<%= content.url %>" allowfullscreen></iframe>
<% } else { %>
<video controls poster="<%= content.image %>"><source src="<%= content.url %>"></video>
<% } %>
</div>
<div class="info">
<h1><%= content.title %></h1>
<p><%= content.category %> - <%= content.type %></p>
<a href="/">← Volver al inicio</a>
</div>
</body>
</html>
