<!DOCTYPE html>
<html>
<head>
<title><%= settings.site_name %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>body{background:#0f0f0f;color:#fff;font-family:sans-serif;margin:0;padding:20px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:15px}.card{background:#1e1e1e;border-radius:10px;overflow:hidden;text-decoration:none;color:#fff}.card img{width:100%;height:240px;object-fit:cover}.card div{padding:10px}h1{color:#e50914}</style>
</head>
<body>
<h1><%= settings.site_name %></h1>
<a href="/login" style="color:#fff">Login Admin</a>
<div class="grid" style="margin-top:20px">
<% contents.forEach(c=>{ %>
<a class="card" href="/player/<%= c.id %>">
<img src="<%= c.image || 'https://via.placeholder.com/160x240?text=No+Image' %>">
<div><b><%= c.title %></b><br><small><%= c.category %> - <%= c.type %></small></div>
</a>
<% }) %>
</div>
</body>
</html>
